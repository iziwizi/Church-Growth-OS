rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================================
    // HELPER FUNCTIONS
    // ============================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.superAdmin == true ||
        request.auth.token.role == 'super_admin'
      );
    }

    // Safe user doc getter — used only for reads, not creates
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Check church membership — safe for both create and read/update/delete
    // On create, resource does not exist, so we cannot reference resource.data
    function isChurchMember(churchId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        request.auth.token.churchId == churchId ||
        getUserData().churchId == churchId ||
        get(/databases/$(database)/documents/churches/$(churchId)).data.ownerId == request.auth.uid
      );
    }

    // Check church owner or admin — safe for creates (does not use resource.data)
    function isChurchOwner(churchId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        get(/databases/$(database)/documents/churches/$(churchId)).data.ownerId == request.auth.uid ||
        request.auth.token.churchId == churchId && (
          request.auth.token.role == 'owner' ||
          request.auth.token.role == 'admin'
        ) ||
        getUserData().role in ['owner', 'admin', 'super_admin']
      );
    }

    // ============================================================================
    // USERS (/users/{userId})
    // ============================================================================

    match /users/{userId} {
      allow read: if isAuthenticated() && (
        isUser(userId) ||
        isSuperAdmin() ||
        (resource != null && resource.data.churchId == request.auth.token.churchId)
      );
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (isUser(userId) || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    // ============================================================================
    // CHURCHES (/churches/{churchId}) + ALL SUBCOLLECTIONS
    // ============================================================================

    match /churches/{churchId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.ownerId == request.auth.uid ||
        request.auth.token.churchId == churchId ||
        getUserData().churchId == churchId
      );

      // Setup Wizard creates this — user is authenticated, sets themselves as ownerId
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        request.resource.data.ownerId == request.auth.uid
      );

      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.ownerId == request.auth.uid ||
        request.auth.token.churchId == churchId ||
        getUserData().churchId == churchId
      );

      allow delete: if isSuperAdmin();

      // ── People (Unified People Engine) ────────────────────────────────────
      match /people/{personId} {
        allow read, create, update: if isChurchMember(churchId);
        allow delete: if isChurchOwner(churchId);
      }

      // ── Members ───────────────────────────────────────────────────────────
      match /members/{memberId} {
        allow read, create, update: if isChurchMember(churchId);
        allow delete: if isChurchOwner(churchId);
      }

      // ── Visitors ──────────────────────────────────────────────────────────
      match /visitors/{visitorId} {
        allow read, create, update: if isChurchMember(churchId);
        allow delete: if isChurchOwner(churchId);
      }

      // ── Events ────────────────────────────────────────────────────────────
      match /events/{eventId} {
        allow read, create, update: if isChurchMember(churchId);
        allow delete: if isChurchOwner(churchId);
      }

      // ── Attendance ────────────────────────────────────────────────────────
      match /attendance/{attendanceId} {
        allow read, create, update: if isChurchMember(churchId);
        allow delete: if isChurchOwner(churchId);
      }

      // ── Prayer Requests ───────────────────────────────────────────────────
      match /prayerRequests/{requestId} {
        allow read, create, update: if isChurchMember(churchId);
        allow delete: if isChurchOwner(churchId);
      }

      // ── Sermons ───────────────────────────────────────────────────────────
      match /sermons/{sermonId} {
        allow read, create, update: if isChurchMember(churchId);
        allow delete: if isChurchOwner(churchId);
      }

      // ── Donations & Offerings ─────────────────────────────────────────────
      match /donations/{donationId} {
        allow read, create, update: if isChurchOwner(churchId);
        allow delete: if isChurchOwner(churchId);
      }

      match /offerings/{offeringId} {
        allow read, create, update: if isChurchOwner(churchId);
        allow delete: if isChurchOwner(churchId);
      }

      // ── Communications ────────────────────────────────────────────────────
      match /communications/{commId} {
        allow read, create, update: if isChurchMember(churchId);
        allow delete: if isChurchOwner(churchId);
      }

      // ── Automation Workflows ──────────────────────────────────────────────
      match /automationWorkflows/{workflowId} {
        allow read, create, update: if isChurchMember(churchId);
        allow delete: if isChurchOwner(churchId);
      }

      match /automations/{automationId} {
        allow read, create, update: if isChurchMember(churchId);
        allow delete: if isChurchOwner(churchId);
      }

      // ── Settings ──────────────────────────────────────────────────────────
      match /settings/{settingId} {
        allow read: if isChurchMember(churchId);
        allow write: if isChurchOwner(churchId);
      }

      // ── Audit Logs (server-write only) ────────────────────────────────────
      match /auditLogs/{logId} {
        allow read: if isChurchOwner(churchId);
        allow write: if false;
      }

      // ── Testimonies ───────────────────────────────────────────────────────
      match /testimonies/{testimonyId} {
        allow read, create, update: if isChurchMember(churchId);
        allow delete: if isChurchOwner(churchId);
      }

      // ── Partnerships ──────────────────────────────────────────────────────
      match /partnerships/{partnerId} {
        allow read, create, update: if isChurchOwner(churchId);
        allow delete: if isChurchOwner(churchId);
      }

      // ── Live Service Sessions ─────────────────────────────────────────────
      match /liveServices/{sessionId} {
        allow read: if isChurchMember(churchId);
        allow create, update: if isChurchOwner(churchId);
        allow delete: if isChurchOwner(churchId);
      }

      // ── AI Profile & Generated Content ────────────────────────────────────
      // Path: churches/{churchId}/ai/profile
      match /ai/{aiId} {
        allow read, create, update: if isChurchMember(churchId);
        allow delete: if isChurchOwner(churchId);
      }

      // Legacy path alias
      match /aiProfile/{aiId} {
        allow read, create, update: if isChurchMember(churchId);
        allow delete: if isChurchOwner(churchId);
      }

      match /aiContent/{contentId} {
        allow read, create, update: if isChurchMember(churchId);
        allow delete: if isChurchOwner(churchId);
      }

      // ── Support Tickets ───────────────────────────────────────────────────
      match /supportTickets/{ticketId} {
        allow read, create, update: if isChurchMember(churchId);
        allow delete: if isChurchOwner(churchId);
      }

      // ── Satellite Branches ────────────────────────────────────────────────
      match /branches/{branchId} {
        allow read, create, update: if isChurchMember(churchId);
        allow delete: if isChurchOwner(churchId);
      }

      // ── Subscription ──────────────────────────────────────────────────────
      match /subscription/{subId} {
        allow read: if isChurchMember(churchId);
        allow write: if isChurchOwner(churchId);
      }

      // ── Reports ───────────────────────────────────────────────────────────
      match /reports/{reportId} {
        allow read: if isChurchMember(churchId);
        allow create, update: if isChurchOwner(churchId);
        allow delete: if isChurchOwner(churchId);
      }

      // ── Social Links & Ingestion Config ───────────────────────────────────
      match /socialConfig/{configId} {
        allow read, create, update: if isChurchMember(churchId);
        allow delete: if isChurchOwner(churchId);
      }
    }

    // ============================================================================
    // AI EXECUTIVE REPORTS (/aiReports/{churchId}/daily/{reportId})
    // ============================================================================

    match /aiReports/{churchId}/daily/{reportId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        request.auth.token.churchId == churchId ||
        get(/databases/$(database)/documents/churches/$(churchId)).data.ownerId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.churchId == churchId
      );
      allow write: if false;
    }

    // ============================================================================
    // SYSTEM — Infrastructure Secrets & Pricing Engine
    // (/system/infrastructure, /system/pricing, /system/*)
    // ============================================================================

    match /system/{document=**} {
      // All authenticated users can READ system/pricing (needed by Pricing page + feature gating)
      allow read: if isAuthenticated();
      // Only Super Admins can WRITE system config
      allow write: if isSuperAdmin();
    }

    // ============================================================================
    // PLATFORM SUPPORT TICKETS (/platformSupportTickets/{ticketId})
    // ============================================================================

    match /platformSupportTickets/{ticketId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isSuperAdmin();
    }

    // ============================================================================
    // NOTIFICATIONS (/notifications/{notificationId})
    // ============================================================================

    match /notifications/{notificationId} {
      allow read, update: if isAuthenticated() && (
        resource == null || resource.data.userId == request.auth.uid
      );
      allow create: if isAuthenticated();
      allow delete: if isAuthenticated() && (
        resource == null || resource.data.userId == request.auth.uid
      );
    }

    // ============================================================================
    // PAYMENTS, INVOICES, COUPONS, ANNOUNCEMENTS, AUDIT LOGS
    // ============================================================================

    match /payments/{paymentId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isSuperAdmin();
    }

    match /invoices/{invoiceId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isSuperAdmin();
    }

    match /coupons/{couponId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /auditLogs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow delete: if isSuperAdmin();
    }

    // ============================================================================
    // DEFAULT DENY ALL
    // ============================================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
