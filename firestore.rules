rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================================
    // HELPER FUNCTIONS
    // ============================================================================

    // Check if request is from an authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the current user matches the requested UID
    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check if user is platform Super Admin
    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.superAdmin == true;
    }

    // Get user's custom claim role or fallback to user document role
    function getUserRole() {
      return request.auth.token.role;
    }

    // Check if user has one of the allowed roles
    function hasRole(roles) {
      return isAuthenticated() && (
        getUserRole() in roles ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in roles
      );
    }

    // Check if the user belongs to or owns the specified church
    function isChurchMember(churchId) {
      return isAuthenticated() && (
        request.auth.token.churchId == churchId ||
        resource.data.ownerId == request.auth.uid ||
        get(/databases/$(database)/documents/churches/$(churchId)).data.ownerId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.churchId == churchId ||
        isSuperAdmin()
      );
    }

    // Check if the user is the owner or administrator of the specified church
    function isChurchOwnerOrAdmin(churchId) {
      return isChurchMember(churchId) && (
        resource.data.ownerId == request.auth.uid ||
        get(/databases/$(database)/documents/churches/$(churchId)).data.ownerId == request.auth.uid ||
        hasRole(['owner', 'super_admin', 'admin']) ||
        isSuperAdmin()
      );
    }

    // ============================================================================
    // GLOBAL USERS COLLECTION (/users/{userId})
    // ============================================================================

    match /users/{userId} {
      // Authenticated users can read their own profile or users in their church
      allow read: if isAuthenticated() && (
        isUser(userId) ||
        resource.data.churchId == request.auth.token.churchId ||
        isSuperAdmin()
      );

      // Authenticated user creates their own profile document during registration
      allow create: if isAuthenticated() && request.auth.uid == userId;

      // Users can update their own profile; Super Admins can manage any profile
      allow update: if isAuthenticated() && (
        isUser(userId) || isSuperAdmin()
      );

      // Only Super Admins can delete user profiles
      allow delete: if isSuperAdmin();
    }

    // ============================================================================
    // CHURCHES COLLECTION (/churches/{churchId})
    // ============================================================================

    match /churches/{churchId} {
      // Allow reading church doc if user owns it, belongs to it, or is super admin
      allow read: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        request.auth.token.churchId == churchId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.churchId == churchId ||
        isSuperAdmin()
      );

      // Setup Wizard: Authenticated user creates a church where they are assigned as ownerId
      allow create: if isAuthenticated() && (
        request.resource.data.ownerId == request.auth.uid || isSuperAdmin()
      );

      // Only church owner or admin can update church settings/branding
      allow update: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        request.auth.token.churchId == churchId ||
        isSuperAdmin()
      );

      // Only Super Admin can delete a church
      allow delete: if isSuperAdmin();

      // ── Subcollection: People (Unified People Engine) ──────────────────────
      match /people/{personId} {
        allow read: if isChurchMember(churchId);
        allow create, update: if isChurchMember(churchId);
        allow delete: if isChurchOwnerOrAdmin(churchId);
      }

      // ── Subcollection: Members ─────────────────────────────────────────────
      match /members/{memberId} {
        allow read: if isChurchMember(churchId);
        allow create, update: if isChurchMember(churchId);
        allow delete: if isChurchOwnerOrAdmin(churchId);
      }

      // ── Subcollection: Visitors ────────────────────────────────────────────
      match /visitors/{visitorId} {
        allow read: if isChurchMember(churchId);
        allow create, update: if isChurchMember(churchId);
        allow delete: if isChurchOwnerOrAdmin(churchId);
      }

      // ── Subcollection: Events ──────────────────────────────────────────────
      match /events/{eventId} {
        allow read: if isChurchMember(churchId);
        allow create, update: if isChurchMember(churchId);
        allow delete: if isChurchOwnerOrAdmin(churchId);
      }

      // ── Subcollection: Attendance ──────────────────────────────────────────
      match /attendance/{attendanceId} {
        allow read: if isChurchMember(churchId);
        allow create, update: if isChurchMember(churchId);
        allow delete: if isChurchOwnerOrAdmin(churchId);
      }

      // ── Subcollection: Prayer Requests ─────────────────────────────────────
      match /prayerRequests/{requestId} {
        allow read: if isChurchMember(churchId);
        allow create: if isAuthenticated() || isChurchMember(churchId);
        allow update, delete: if isChurchMember(churchId);
      }

      // ── Subcollection: Sermons ─────────────────────────────────────────────
      match /sermons/{sermonId} {
        allow read: if isChurchMember(churchId);
        allow create, update: if isChurchMember(churchId);
        allow delete: if isChurchOwnerOrAdmin(churchId);
      }

      // ── Subcollection: Donations & Offerings ──────────────────────────────
      match /donations/{donationId} {
        allow read, create, update: if isChurchOwnerOrAdmin(churchId);
        allow delete: if isChurchOwnerOrAdmin(churchId);
      }

      match /offerings/{offeringId} {
        allow read, create, update: if isChurchOwnerOrAdmin(churchId);
        allow delete: if isChurchOwnerOrAdmin(churchId);
      }

      // ── Subcollection: Communications ──────────────────────────────────────
      match /communications/{commId} {
        allow read, create, update: if isChurchMember(churchId);
        allow delete: if isChurchOwnerOrAdmin(churchId);
      }

      // ── Subcollection: Automation Workflows ──────────────────────────────
      match /automationWorkflows/{workflowId} {
        allow read, create, update: if isChurchMember(churchId);
        allow delete: if isChurchOwnerOrAdmin(churchId);
      }

      match /automations/{automationId} {
        allow read, create, update: if isChurchMember(churchId);
        allow delete: if isChurchOwnerOrAdmin(churchId);
      }

      // ── Subcollection: Settings ───────────────────────────────────────────
      match /settings/{settingId} {
        allow read: if isChurchMember(churchId);
        allow write: if isChurchOwnerOrAdmin(churchId);
      }

      // ── Subcollection: Audit Logs (Read-only for owners, server writes) ──
      match /auditLogs/{logId} {
        allow read: if isChurchOwnerOrAdmin(churchId);
        allow write: if false; // Cloud Functions / Admin SDK only
      }

      // ── Subcollection: Testimonies & Partnerships ────────────────────────
      match /testimonies/{testimonyId} {
        allow read, create, update: if isChurchMember(churchId);
        allow delete: if isChurchOwnerOrAdmin(churchId);
      }

      match /partnerships/{partnerId} {
        allow read, create, update: if isChurchOwnerOrAdmin(churchId);
        allow delete: if isChurchOwnerOrAdmin(churchId);
      }

      // ── Subcollection: Live Service Sessions ─────────────────────────────
      match /liveServices/{sessionId} {
        allow read: if isChurchMember(churchId);
        allow create, update: if isChurchOwnerOrAdmin(churchId);
        allow delete: if isChurchOwnerOrAdmin(churchId);
      }

      // ── Subcollection: AI Generated Content ──────────────────────────────
      match /aiContent/{contentId} {
        allow read, create, update: if isChurchMember(churchId);
        allow delete: if isChurchOwnerOrAdmin(churchId);
      }

      // ── Subcollection: Support Tickets ────────────────────────────────────
      match /supportTickets/{ticketId} {
        allow read, create, update: if isChurchMember(churchId);
        allow delete: if isChurchOwnerOrAdmin(churchId);
      }
    }

    // ============================================================================
    // AI EXECUTIVE REPORTS (/aiReports/{churchId}/daily/{reportId})
    // ============================================================================

    match /aiReports/{churchId}/daily/{reportId} {
      allow read: if isAuthenticated() && (
        request.auth.token.churchId == churchId ||
        get(/databases/$(database)/documents/churches/$(churchId)).data.ownerId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.churchId == churchId ||
        isSuperAdmin()
      );
      allow write: if false; // Generated exclusively by Cloud Functions / Firebase Admin SDK
    }

    // ============================================================================
    // NOTIFICATIONS COLLECTION (/notifications/{notificationId})
    // ============================================================================

    match /notifications/{notificationId} {
      allow read, update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Default deny all unmapped documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
